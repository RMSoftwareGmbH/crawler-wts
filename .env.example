GOOGLE_MAX_REVIEWS_PER_RUN=50
GOOGLE_CRAWLER_SETTLE_MS=9000
GOOGLE_CRAWLER_PANEL_WAIT_MS=5000
GOOGLE_CRAWLER_INTERACTION_WAIT_MS=1000
GOOGLE_CRAWLER_PAGINATION_WAIT_MS=1000
GOOGLE_CRAWLER_OPTIMIZE=false
GOOGLE_CRAWLER_LOCALE=en-US
GOOGLE_CRAWLER_HEADED=false
GOOGLE_CRAWLER_INTERACT=false
GOOGLE_CRAWLER_DIAGNOSTIC_SCREENSHOT=false
GOOGLE_CRAWLER_DOM_DIAGNOSTIC=false
GOOGLE_CRAWLER_DIAGNOSTIC_SNAPSHOT=false
GOOGLE_CRAWLER_ALLOW_LEGACY_SCROLL=false
GOOGLE_MAX_SCROLL_ATTEMPTS=50
GOOGLE_REVIEW_SCROLL_WAIT_MS=1000
GOOGLE_NO_PROGRESS_LIMIT=3
GOOGLE_CRAWL_TIMEOUT_MS=120000

# Optional local Google diagnostic script settings.
GOOGLE_DIAG_URL=
GOOGLE_DIAG_HEADLESS=false
GOOGLE_DIAG_PAUSE_MS=3000

# MongoDB is required only when persistence is explicitly enabled.
# Keep credentials in .env or a secret manager; never commit them.
MONGODB_URI=
MONGODB_DB_NAME=
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_RETRY_WRITES=true

# Optional Decodo proxy configuration.
DECODO_PROXY_ENABLED=false
DECODO_PROXY_HOST=
DECODO_PROXY_PORT=
DECODO_PROXY_USERNAME=
DECODO_PROXY_PASSWORD=
DECODO_PROXY_COUNTRY=